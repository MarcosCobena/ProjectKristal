<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Evergine.DirectX11" Version="2026.5.26.2553" />
    <PackageReference Include="Evergine.HLSLEverywhere" Version="2026.5.26.2553" />
    <PackageReference Include="Evergine.XAudio2" Version="2026.5.26.2553" />
    <PackageReference Include="Evergine.Forms" Version="2026.5.26.2553" />
    <PackageReference Include="Evergine.Targets" Version="2026.5.26.2553" />
    <PackageReference Include="Evergine.Targets.Windows" Version="2026.5.26.2553" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProjectKristal\ProjectKristal.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(DefineConstants.Contains('EVERGINE_EDITOR'))">
    <ProjectReference Include="..\ProjectKristal.Editor\ProjectKristal.Editor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Screenshots\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ScreenshotsSourceDir" Value="$(MSBuildProjectDirectory)\Screenshots" />
  </ItemGroup>
</Project>